# Required AI API Keys (at least one valid VLM API key required for full AI descriptions)
GOOGLE_API_KEY=<your-google-gemini-api-key>
OPENROUTER_API_KEY=<your-openrouter-api-key>

# AI Model Configuration
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=google/gemini-2.5-flash

# Required Security Secret Key (app fails loudly at startup if left default/empty in production)
JWT_SECRET_KEY=<generate-a-random-64-character-string>
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_DATABASE=engineering_drawings

# SMTP Email Configuration (optional — falls back to console printing if blank)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-smtp-email>
SMTP_PASSWORD=<your-smtp-app-password>
SMTP_FROM=<your-smtp-email>

# URL Configuration
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
