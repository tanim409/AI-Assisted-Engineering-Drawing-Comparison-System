# Required AI API Keys
GOOGLE_API_KEY=<your-google-gemini-api-key>

# AI Model Configuration
GEMINI_MODEL=gemini-2.0-flash

# Required Security Secret Key (app fails loudly at startup if left default/empty in production)
JWT_SECRET_KEY=<generate-a-random-64-character-string>
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Database Configuration (PostgreSQL/Supabase)
POSTGRES_HOST=aws-0-ap-northeast-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_USER=postgres.[your-project-ref]
POSTGRES_PASSWORD=<your-database-password>
POSTGRES_DATABASE=postgres

# SMTP Email Configuration (optional — falls back to console printing if blank)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-smtp-email>
SMTP_PASSWORD=<your-smtp-app-password>
SMTP_FROM=<your-smtp-email>

# URL Configuration
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
